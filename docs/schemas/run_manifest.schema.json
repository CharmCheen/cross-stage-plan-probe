{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Manifest",
  "type": "object",
  "required": [
    "run_id",
    "git_commit",
    "status",
    "valid",
    "config_hash",
    "manifest_hash",
    "plan_d",
    "plan_t",
    "seed",
    "resources",
    "failure_reason"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "config_hash": {
      "type": "string"
    },
    "manifest_hash": {
      "type": "string"
    },
    "plan_d": {
      "type": "string"
    },
    "plan_t": {
      "type": "string"
    },
    "seed": {"type": ["integer", "null"]},
    "status": {"type": "string", "enum": ["PREFLIGHT", "RUNNING", "VALID", "INVALID"]},
    "rng_scheme_version": {"type": "string", "minLength": 1},
    "workload_version": {"type": "string", "minLength": 1},
    "run_context": {"type": "object"},
    "failure_reason": {"type": ["string", "null"]},
    "resources": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "cache_state": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "invalid_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VALID"}}, "required": ["status"]},
      "then": {"required": ["rng_scheme_version", "workload_version", "run_context"]}
    }
  ],
  "additionalProperties": true
}
